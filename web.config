<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".dwg" />
      <mimeMap fileExtension=".dwg" mimeType="application/octet-stream" />
      <remove fileExtension=".dxf" />
      <mimeMap fileExtension=".dxf" mimeType="application/octet-stream" />
      <remove fileExtension=".stl" />
      <mimeMap fileExtension=".stl" mimeType="model/stl" />
      <remove fileExtension=".stp" />
      <mimeMap fileExtension=".stp" mimeType="application/step" />
      <remove fileExtension=".step" />
      <mimeMap fileExtension=".step" mimeType="application/step" />
      <remove fileExtension=".igs" />
      <mimeMap fileExtension=".igs" mimeType="model/iges" />
      <remove fileExtension=".iges" />
      <mimeMap fileExtension=".iges" mimeType="model/iges" />
      <remove fileExtension=".brep" />
      <mimeMap fileExtension=".brep" mimeType="application/octet-stream" />
      <remove fileExtension=".brp" />
      <mimeMap fileExtension=".brp" mimeType="application/octet-stream" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".shx" />
      <mimeMap fileExtension=".shx" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
